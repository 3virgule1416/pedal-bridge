@prefix doap:   <http://usefulinc.com/ns/doap#> .
@prefix foaf:   <http://xmlns.com/foaf/0.1/> .
@prefix lv2:    <http://lv2plug.in/ns/lv2core#> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix units:  <http://lv2plug.in/ns/extensions/units#> .
@prefix mod:    <http://moddevices.com/ns/mod#> .

<http://pedal-bridge.local/plugins/return>
    a lv2:Plugin, lv2:UtilityPlugin ;
    doap:name "Davis Loop Station Return" ;
    mod:brand "DLS" ;
    mod:label "DLS Return" ;
    doap:maintainer [ a foaf:Person ; foaf:name "Davis" ] ;
    rdfs:comment """Brings audio from JACK applications (SooperLooper loops, Hydrogen drums...) back into the PiPedal chain, through the Davis Loop Station bridge.

The pedal_bridge JACK client writes to a shared buffer on the selected link (1 to 8); this plugin reads it. In Add mode the returned audio is mixed with the signal passing through; in Replace mode it replaces it.

Clock drift between PiPedal and JACK is absorbed by adaptive resampling. Start and stop are faded to avoid clicks. With no JACK client connected, Add mode leaves your signal untouched and Replace mode outputs silence.""" ;
    doap:license <http://opensource.org/licenses/isc> ;
    lv2:minorVersion 1 ;
    lv2:microVersion 0 ;
    lv2:optionalFeature lv2:hardRTCapable ;

    lv2:port [
        a lv2:AudioPort, lv2:InputPort ;
        lv2:index 0 ;
        lv2:symbol "in_l" ;
        lv2:name "Entrée G"
    ] , [
        a lv2:AudioPort, lv2:InputPort ;
        lv2:index 1 ;
        lv2:symbol "in_r" ;
        lv2:name "Entrée D"
    ] , [
        a lv2:AudioPort, lv2:OutputPort ;
        lv2:index 2 ;
        lv2:symbol "out_l" ;
        lv2:name "Sortie G"
    ] , [
        a lv2:AudioPort, lv2:OutputPort ;
        lv2:index 3 ;
        lv2:symbol "out_r" ;
        lv2:name "Sortie D"
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 4 ;
        lv2:symbol "link" ;
        lv2:name "Lien" ;
        rdfs:comment "Bridge link (1 to 8) to read from. The pedal_bridge client exposes it as JACK ports returnN_L/R." ;
        lv2:default 1 ;
        lv2:minimum 1 ;
        lv2:maximum 8 ;
        lv2:portProperty lv2:integer, lv2:enumeration ;
        lv2:scalePoint [ rdfs:label "Lien 1" ; rdf:value 1 ] ,
                       [ rdfs:label "Lien 2" ; rdf:value 2 ] ,
                       [ rdfs:label "Lien 3" ; rdf:value 3 ] ,
                       [ rdfs:label "Lien 4" ; rdf:value 4 ] ,
                       [ rdfs:label "Lien 5" ; rdf:value 5 ] ,
                       [ rdfs:label "Lien 6" ; rdf:value 6 ] ,
                       [ rdfs:label "Lien 7" ; rdf:value 7 ] ,
                       [ rdfs:label "Lien 8" ; rdf:value 8 ]
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 5 ;
        lv2:symbol "mode" ;
        lv2:name "Mode" ;
        rdfs:comment "Add: mix the returned audio with the signal. Replace: output only the returned audio." ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:portProperty lv2:integer, lv2:enumeration ;
        lv2:scalePoint [ rdfs:label "Add" ; rdf:value 0 ] ,
                       [ rdfs:label "Replace" ; rdf:value 1 ]
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 6 ;
        lv2:symbol "gain" ;
        lv2:name "Gain retour" ;
        rdfs:comment "Level of the returned audio." ;
        lv2:default 0.0 ;
        lv2:minimum -60.0 ;
        lv2:maximum 12.0 ;
        units:unit units:db
    ] , [
        a lv2:ControlPort, lv2:OutputPort ;
        lv2:index 7 ;
        lv2:symbol "connected" ;
        lv2:name "Connecté" ;
        rdfs:comment "Lit when the pedal_bridge JACK client is writing to this link." ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:portProperty lv2:toggled
    ] .
