@prefix doap:  <http://usefulinc.com/ns/doap#> .
@prefix epp:   <http://lv2plug.in/ns/ext/port-props#> .
@prefix foaf:  <http://xmlns.com/foaf/0.1/> .
@prefix lv2:   <http://lv2plug.in/ns/lv2core#> .
@prefix mod:   <http://moddevices.com/ns/mod#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix units: <http://lv2plug.in/ns/extensions/units#> .

<http://pedal-bridge.local/plugins/looper-mono>
    a lv2:Plugin, lv2:UtilityPlugin ;
    doap:name "Davis Loop Station Looper (Mono)" ;
    mod:brand "DLS" ;
    mod:label "DLS Looper" ;
    doap:maintainer [ a foaf:Person ; foaf:name "Davis" ] ;
    rdfs:comment """Live looper for Davis Loop Station, driven from PiPedal and your MIDI pedals.

Your signal is sent to SooperLooper through the Davis Loop Station bridge, then the loops are mixed back in. Place it at the start of the chain to record a dry guitar and run the loops through your effects, or at the end to record the loops with their effects. The signal is sent before the loops are added, so loops never record themselves.

Record, Overdub, Undo, Redo, Mute and Clear act on the selected loop. Starts and ends of recordings fall exactly on the beat grid of the tempo. Play/Stop stops or restarts everything (loops and drums) from bar 1.

Needs the pedal_bridge client and SooperLooper running on the Raspberry Pi (scripts/session.sh start). Without them, your signal passes through unchanged.""" ;
    doap:license <http://opensource.org/licenses/isc> ;
    lv2:minorVersion 1 ; lv2:microVersion 0 ;
    lv2:optionalFeature lv2:hardRTCapable ;
    lv2:port
    [ a lv2:AudioPort, lv2:InputPort ; lv2:index 0 ; lv2:symbol "in" ; lv2:name "Entrée" ] ,
    [ a lv2:AudioPort, lv2:OutputPort ; lv2:index 1 ; lv2:symbol "out" ; lv2:name "Sortie" ] ,
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 2 ; lv2:symbol "boucle" ; lv2:name "Boucle" ;
      rdfs:comment "Loop that the buttons act on (SooperLooper loop 1 to 8)." ;
      lv2:default 1 ; lv2:minimum 1 ; lv2:maximum 8 ; lv2:portProperty lv2:integer, lv2:enumeration ;
      lv2:scalePoint [ rdfs:label "Boucle 1" ; rdf:value 1 ] ,
                     [ rdfs:label "Boucle 2" ; rdf:value 2 ] ,
                     [ rdfs:label "Boucle 3" ; rdf:value 3 ] ,
                     [ rdfs:label "Boucle 4" ; rdf:value 4 ] ,
                     [ rdfs:label "Boucle 5" ; rdf:value 5 ] ,
                     [ rdfs:label "Boucle 6" ; rdf:value 6 ] ,
                     [ rdfs:label "Boucle 7" ; rdf:value 7 ] ,
                     [ rdfs:label "Boucle 8" ; rdf:value 8 ] ] ,
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 3 ; lv2:symbol "record" ; lv2:name "Record" ;
      rdfs:comment "Start recording at the next cycle; press again to stop at the end of the cycle." ;
      lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:portProperty lv2:toggled, epp:trigger ] ,
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 4 ; lv2:symbol "overdub" ; lv2:name "Overdub" ;
      rdfs:comment "Add a layer over the loop; press again to stop." ;
      lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:portProperty lv2:toggled, epp:trigger ] ,
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 5 ; lv2:symbol "undo" ; lv2:name "Undo" ;
      rdfs:comment "Remove the last layer." ;
      lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:portProperty lv2:toggled, epp:trigger ] ,
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 6 ; lv2:symbol "redo" ; lv2:name "Redo" ;
      rdfs:comment "Put back the last removed layer." ;
      lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:portProperty lv2:toggled, epp:trigger ] ,
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 7 ; lv2:symbol "mute" ; lv2:name "Mute" ;
      rdfs:comment "Silence the loop, or bring it back." ;
      lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:portProperty lv2:toggled, epp:trigger ] ,
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 8 ; lv2:symbol "effacer" ; lv2:name "Effacer" ;
      rdfs:comment "Clear the loop completely." ;
      lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:portProperty lv2:toggled, epp:trigger ] ,
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 9 ; lv2:symbol "play_stop" ; lv2:name "Play / Stop" ;
      rdfs:comment "Stop everything, or restart loops and drums together from bar 1." ;
      lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:portProperty lv2:toggled, epp:trigger ] ,
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 10 ; lv2:symbol "tempo" ; lv2:name "Tempo" ;
      rdfs:comment "Tempo in BPM, applied when you change it. Set it before recording: loops do not stretch." ;
      lv2:default 120 ; lv2:minimum 40 ; lv2:maximum 240 ; lv2:portProperty lv2:integer ; units:unit units:bpm ] ,
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 11 ; lv2:symbol "gain" ; lv2:name "Volume boucles" ;
      rdfs:comment "Level of the loops mixed into your signal." ;
      lv2:default 0.0 ; lv2:minimum -60.0 ; lv2:maximum 12.0 ; units:unit units:db ] ,
    [ a lv2:ControlPort, lv2:OutputPort ; lv2:index 12 ; lv2:symbol "etat" ; lv2:name "État de la boucle" ;
      rdfs:comment "State of the selected loop." ;
      lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 8 ; lv2:portProperty lv2:integer, lv2:enumeration ;
      lv2:scalePoint [ rdfs:label "hors ligne" ; rdf:value 0 ] ,
                     [ rdfs:label "vide" ; rdf:value 1 ] ,
                     [ rdfs:label "attente" ; rdf:value 2 ] ,
                     [ rdfs:label "enregistre" ; rdf:value 3 ] ,
                     [ rdfs:label "overdub" ; rdf:value 4 ] ,
                     [ rdfs:label "lecture" ; rdf:value 5 ] ,
                     [ rdfs:label "muet" ; rdf:value 6 ] ,
                     [ rdfs:label "pause" ; rdf:value 7 ] ,
                     [ rdfs:label "autre" ; rdf:value 8 ] ] ,
    [ a lv2:ControlPort, lv2:OutputPort ; lv2:index 13 ; lv2:symbol "temps" ; lv2:name "Temps de la mesure" ;
      rdfs:comment "Current beat in the bar (- when stopped)." ;
      lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 8 ; lv2:portProperty lv2:integer, lv2:enumeration ;
      lv2:scalePoint [ rdfs:label "-" ; rdf:value 0 ] ,
                     [ rdfs:label "1" ; rdf:value 1 ] ,
                     [ rdfs:label "2" ; rdf:value 2 ] ,
                     [ rdfs:label "3" ; rdf:value 3 ] ,
                     [ rdfs:label "4" ; rdf:value 4 ] ,
                     [ rdfs:label "5" ; rdf:value 5 ] ,
                     [ rdfs:label "6" ; rdf:value 6 ] ,
                     [ rdfs:label "7" ; rdf:value 7 ] ,
                     [ rdfs:label "8" ; rdf:value 8 ] ] ,
    [ a lv2:ControlPort, lv2:OutputPort ; lv2:index 14 ; lv2:symbol "pulsation" ; lv2:name "Pulsation" ;
      rdfs:comment "Flashes on every beat." ;
      lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:portProperty lv2:toggled ] ,
    [ a lv2:ControlPort, lv2:OutputPort ; lv2:index 15 ; lv2:symbol "sur_le_1" ; lv2:name "Sur le 1" ;
      rdfs:comment "Flashes on the first beat of each bar." ;
      lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:portProperty lv2:toggled ] ,
    [ a lv2:ControlPort, lv2:OutputPort ; lv2:index 16 ; lv2:symbol "lecture" ; lv2:name "En lecture" ;
      rdfs:comment "Lit while the transport is playing." ;
      lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:portProperty lv2:toggled ] ,
    [ a lv2:ControlPort, lv2:OutputPort ; lv2:index 17 ; lv2:symbol "tempo_actuel" ; lv2:name "Tempo actuel" ;
      rdfs:comment "Tempo currently used by the bridge (BPM)." ;
      lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 240 ; lv2:portProperty lv2:integer, lv2:enumeration ;
      lv2:scalePoint [ rdfs:label "-" ; rdf:value 0 ] ,
