<http://pedal-bridge.local/plugins/looper-stereo>
    a lv2:Plugin, lv2:UtilityPlugin ;
    doap:name "Davis Loop Station Looper (Stéréo)" ;
    mod:brand "DLS" ;
    mod:label "DLS Looper St." ;
    doap:maintainer [ a foaf:Person ; foaf:name "Davis" ] ;
    rdfs:comment """Live looper for Davis Loop Station, driven from PiPedal and your MIDI pedals.

Your signal is sent to SooperLooper through the Davis Loop Station bridge, then the loops are mixed back in. Place it at the start of the chain to record a dry guitar and run the loops through your effects, or at the end to record the loops with their effects. The signal is sent before the loops are added, so loops never record themselves.

Record, Overdub, Undo, Redo, Mute and Clear act on the selected loop. Starts and ends of recordings fall exactly on the beat grid of the tempo. Play/Stop stops or restarts everything (loops and drums) from bar 1.

Needs the pedal_bridge client and SooperLooper running on the Raspberry Pi (scripts/session.sh start). Without them, your signal passes through unchanged.""" ;
    doap:license <http://opensource.org/licenses/isc> ;
    lv2:minorVersion 1 ; lv2:microVersion 0 ;
    lv2:optionalFeature lv2:hardRTCapable ;
    lv2:port
    [ a lv2:AudioPort, lv2:InputPort ; lv2:index 0 ; lv2:symbol "in_l" ; lv2:name "Entrée G" ] ,
    [ a lv2:AudioPort, lv2:InputPort ; lv2:index 1 ; lv2:symbol "in_r" ; lv2:name "Entrée D" ] ,
    [ a lv2:AudioPort, lv2:OutputPort ; lv2:index 2 ; lv2:symbol "out_l" ; lv2:name "Sortie G" ] ,
    [ a lv2:AudioPort, lv2:OutputPort ; lv2:index 3 ; lv2:symbol "out_r" ; lv2:name "Sortie D" ] ,
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 4 ; lv2:symbol "boucle" ; lv2:name "Boucle" ;
      rdfs:comment "Loop that the buttons act on (SooperLooper loop 1 to 8)." ;
      lv2:default 1 ; lv2:minimum 1 ; lv2:maximum 8 ; lv2:portProperty lv2:integer, lv2:enumeration ;
      lv2:scalePoint [ rdfs:label "Boucle 1" ; rdf:value 1 ] ,
                     [ rdfs:label "Boucle 2" ; rdf:value 2 ] ,
                     [ rdfs:label "Boucle 3" ; rdf:value 3 ] ,
                     [ rdfs:label "Boucle 4" ; rdf:value 4 ] ,
                     [ rdfs:label "Boucle 5" ; rdf:value 5 ] ,
                     [ rdfs:label "Boucle 6" ; rdf:value 6 ] ,
                     [ rdfs:label "Boucle 7" ; rdf:value 7 ] ,
                     [ rdfs:label "Boucle 8" ; rdf:value 8 ] ] ,
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 5 ; lv2:symbol "record" ; lv2:name "Record" ;
      rdfs:comment "Start recording at the next cycle; press again to stop at the end of the cycle." ;
      lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:portProperty lv2:toggled, epp:trigger ] ,
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 6 ; lv2:symbol "overdub" ; lv2:name "Overdub" ;
      rdfs:comment "Add a layer over the loop; press again to stop." ;
      lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:portProperty lv2:toggled, epp:trigger ] ,
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 7 ; lv2:symbol "undo" ; lv2:name "Undo" ;
      rdfs:comment "Remove the last layer." ;
      lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:portProperty lv2:toggled, epp:trigger ] ,
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 8 ; lv2:symbol "redo" ; lv2:name "Redo" ;
      rdfs:comment "Put back the last removed layer." ;
