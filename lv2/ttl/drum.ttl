    [ a lv2:ControlPort, lv2:OutputPort ; lv2:index 14 ; lv2:symbol "sur_le_1" ; lv2:name "1" ;
      rdfs:comment "Flashes on the first beat of each bar." ;
      lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:portProperty lv2:toggled ;
      pg:group <http://pedal-bridge.local/plugins/drum#transport_g> ;
      pipedal_ui:ledColor "red" ] ,
    [ a lv2:ControlPort, lv2:OutputPort ; lv2:index 15 ; lv2:symbol "lecture" ; lv2:name "▶" ;
