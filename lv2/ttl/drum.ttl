                     [ rdfs:label "32" ; rdf:value 32 ] ;
      pg:group <http://pedal-bridge.local/plugins/drum#drum_g> ] ,
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 6 ; lv2:symbol "play_stop" ; lv2:name "Play / Stop" ;
      rdfs:comment "Stop everything, or restart drums and loops together from bar 1." ;
      lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:portProperty lv2:toggled, epp:trigger ;
      pg:group <http://pedal-bridge.local/plugins/drum#transport_g> ] ,
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 7 ; lv2:symbol "tempo" ; lv2:name "Tempo" ;
      rdfs:comment "Tempo in BPM, applied when you change it. Set it before recording: loops do not stretch." ;
      lv2:default 120 ; lv2:minimum 40 ; lv2:maximum 240 ; lv2:portProperty lv2:integer ; units:unit units:bpm ;
      pg:group <http://pedal-bridge.local/plugins/drum#transport_g> ] ,
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 8 ; lv2:symbol "bpm_plus" ; lv2:name "BPM +" ;
      rdfs:comment "Raise the tempo by 1 BPM. Hold it to keep going, faster after 2 seconds." ;
      lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:portProperty lv2:toggled, mod:preferMomentaryOffByDefault ;
      pg:group <http://pedal-bridge.local/plugins/drum#transport_g> ] ,
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 9 ; lv2:symbol "bpm_moins" ; lv2:name "BPM -" ;
      rdfs:comment "Lower the tempo by 1 BPM. Hold it to keep going, faster after 2 seconds." ;
      lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:portProperty lv2:toggled, mod:preferMomentaryOffByDefault ;
      pg:group <http://pedal-bridge.local/plugins/drum#transport_g> ] ,
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 10 ; lv2:symbol "tap" ; lv2:name "Tap" ;
      rdfs:comment "Tap the beat: the tempo follows your last taps (3 taps or more)." ;
      lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:portProperty lv2:toggled, epp:trigger ;
      pg:group <http://pedal-bridge.local/plugins/drum#transport_g> ] ,
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 11 ; lv2:symbol "metronome" ; lv2:name "Metronome" ;
      rdfs:comment "Hydrogen metronome click on or off." ;
      lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:portProperty lv2:toggled ;
      pg:group <http://pedal-bridge.local/plugins/drum#transport_g> ] ,
    [ a lv2:ControlPort, lv2:OutputPort ; lv2:index 12 ; lv2:symbol "temps" ; lv2:name "Beat" ;
      rdfs:comment "Current beat in the bar (- when stopped)." ;
      lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 8 ; lv2:portProperty lv2:integer, lv2:enumeration ;
      lv2:scalePoint [ rdfs:label "-" ; rdf:value 0 ] ,
                     [ rdfs:label "1" ; rdf:value 1 ] ,
                     [ rdfs:label "2" ; rdf:value 2 ] ,
                     [ rdfs:label "3" ; rdf:value 3 ] ,
                     [ rdfs:label "4" ; rdf:value 4 ] ,
