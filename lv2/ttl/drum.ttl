@prefix atom:  <http://lv2plug.in/ns/ext/atom#> .
@prefix doap:  <http://usefulinc.com/ns/doap#> .
@prefix epp:   <http://lv2plug.in/ns/ext/port-props#> .
@prefix foaf:  <http://xmlns.com/foaf/0.1/> .
@prefix lv2:   <http://lv2plug.in/ns/lv2core#> .
@prefix mod:   <http://moddevices.com/ns/mod#> .
@prefix patch: <http://lv2plug.in/ns/ext/patch#> .
@prefix pg:    <http://lv2plug.in/ns/ext/port-groups#> .
@prefix pipedal_ui: <http://github.com/rerdavies/pipedal/ui#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix state: <http://lv2plug.in/ns/ext/state#> .
@prefix urid:  <http://lv2plug.in/ns/ext/urid#> .
@prefix units: <http://lv2plug.in/ns/extensions/units#> .

<http://pedal-bridge.local/plugins/drum#drum_g>
    a pg:ControlGroup ;
    lv2:name "Drums" ;
    lv2:symbol "drum_g" .

<http://pedal-bridge.local/plugins/drum#transport_g>
    a pg:ControlGroup ;
    lv2:name "Transport" ;
    lv2:symbol "transport_g" .

<http://pedal-bridge.local/plugins/drum#pont_g>
    a pg:ControlGroup ;
    lv2:name "Bridge" ;
    lv2:symbol "pont_g" .

<http://pedal-bridge.local/plugins/drum#kit>
    a lv2:Parameter ;
    rdfs:label "Kit" ;
    mod:fileTypes "kit" ;
    rdfs:range atom:Path .

<http://pedal-bridge.local/plugins/drum#song>
    a lv2:Parameter ;
    rdfs:label "Song" ;
    mod:fileTypes "h2song" ;
    rdfs:range atom:Path .

<http://pedal-bridge.local/plugins/drum-mono>
    a lv2:Plugin, lv2:UtilityPlugin ;
    doap:name "Davis Loop Station Drum (Mono)" ;
    mod:brand "DLS" ;
    mod:label "DLS Drum" ;
    doap:maintainer [ a foaf:Person ; foaf:name "Davis" ] ;
    rdfs:comment """Drums for Davis Loop Station: the Hydrogen drum machine, played in time with your loops and driven from PiPedal and your MIDI pedals.

The drums are mixed into your signal. Place it at the end of the chain so the drums go through none of your effects. Without this plugin in the preset, the drums are silent, but the tempo and the bar grid keep working for the loops.

Kit picks the drum kit (a .kit file of the "DLS Kits" folder) and Song the style (a .h2song file of the "DLS Drums" folder): every song plays on the chosen kit. A new choice is loaded when the transport is stopped. Groove selects the Hydrogen pattern (1 to 16); Previous and Next step through them, for your pedals. The new groove starts at the next bar, and the length of a SooperLooper cycle follows the length of the groove. Play/Stop stops or restarts everything (drums and loops) from bar 1. BPM + and BPM - change the tempo by 1 (hold them to go faster). Tap sets the tempo from your last taps. Metronome turns the Hydrogen click on or off.

Needs the pedal_bridge client and Hydrogen running on the Raspberry Pi (scripts/session.sh start).""" ;
    doap:license <http://opensource.org/licenses/isc> ;
    lv2:minorVersion 1 ; lv2:microVersion 0 ;
    lv2:optionalFeature lv2:hardRTCapable ;
    lv2:optionalFeature urid:map ;
    lv2:extensionData state:interface ;
    patch:readable <http://pedal-bridge.local/plugins/drum#kit>, <http://pedal-bridge.local/plugins/drum#song> ;
    patch:writable <http://pedal-bridge.local/plugins/drum#kit>, <http://pedal-bridge.local/plugins/drum#song> ;
    lv2:port
    [ a lv2:AudioPort, lv2:InputPort ; lv2:index 0 ; lv2:symbol "in" ; lv2:name "In" ] ,
    [ a lv2:AudioPort, lv2:OutputPort ; lv2:index 1 ; lv2:symbol "out" ; lv2:name "Out" ] ,
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 2 ; lv2:symbol "groove" ; lv2:name "Groove" ;
      rdfs:comment "Hydrogen pattern to play (1 = first pattern of the song), from the next bar." ;
      lv2:default 1 ; lv2:minimum 1 ; lv2:maximum 16 ; lv2:portProperty lv2:integer, lv2:enumeration ;
      lv2:scalePoint [ rdfs:label "Groove 1" ; rdf:value 1 ] ,
                     [ rdfs:label "Groove 2" ; rdf:value 2 ] ,
                     [ rdfs:label "Groove 3" ; rdf:value 3 ] ,
                     [ rdfs:label "Groove 4" ; rdf:value 4 ] ,
                     [ rdfs:label "Groove 5" ; rdf:value 5 ] ,
                     [ rdfs:label "Groove 6" ; rdf:value 6 ] ,
                     [ rdfs:label "Groove 7" ; rdf:value 7 ] ,
                     [ rdfs:label "Groove 8" ; rdf:value 8 ] ,
                     [ rdfs:label "Groove 9" ; rdf:value 9 ] ,
                     [ rdfs:label "Groove 10" ; rdf:value 10 ] ,
                     [ rdfs:label "Groove 11" ; rdf:value 11 ] ,
                     [ rdfs:label "Groove 12" ; rdf:value 12 ] ,
                     [ rdfs:label "Groove 13" ; rdf:value 13 ] ,
                     [ rdfs:label "Groove 14" ; rdf:value 14 ] ,
                     [ rdfs:label "Groove 15" ; rdf:value 15 ] ,
                     [ rdfs:label "Groove 16" ; rdf:value 16 ] ;
      pg:group <http://pedal-bridge.local/plugins/drum#drum_g> ] ,
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 3 ; lv2:symbol "precedent" ; lv2:name "Previous" ;
      rdfs:comment "Previous groove, from the next bar." ;
      lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:portProperty lv2:toggled, epp:trigger ;
      pg:group <http://pedal-bridge.local/plugins/drum#drum_g> ] ,
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 4 ; lv2:symbol "suivant" ; lv2:name "Next" ;
      rdfs:comment "Next groove, from the next bar." ;
      lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:portProperty lv2:toggled, epp:trigger ;
      pg:group <http://pedal-bridge.local/plugins/drum#drum_g> ] ,
    [ a lv2:ControlPort, lv2:OutputPort ; lv2:index 5 ; lv2:symbol "groove_joue" ; lv2:name "Playing" ;
      rdfs:comment "Groove being played (- when unknown)." ;
      lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 32 ; lv2:portProperty lv2:integer, lv2:enumeration ;
      lv2:scalePoint [ rdfs:label "-" ; rdf:value 0 ] ,
                     [ rdfs:label "1" ; rdf:value 1 ] ,
                     [ rdfs:label "2" ; rdf:value 2 ] ,
                     [ rdfs:label "3" ; rdf:value 3 ] ,
                     [ rdfs:label "4" ; rdf:value 4 ] ,
