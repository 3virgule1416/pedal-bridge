@prefix doap:   <http://usefulinc.com/ns/doap#> .
@prefix foaf:   <http://xmlns.com/foaf/0.1/> .
@prefix lv2:    <http://lv2plug.in/ns/lv2core#> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix units:  <http://lv2plug.in/ns/extensions/units#> .
@prefix mod:    <http://moddevices.com/ns/mod#> .

<http://pedal-bridge.local/plugins/send>
    a lv2:Plugin, lv2:UtilityPlugin ;
    doap:name "Davis Loop Station Send" ;
    mod:brand "DLS" ;
    mod:label "DLS Send" ;
    doap:maintainer [ a foaf:Person ; foaf:name "Davis" ] ;
    rdfs:comment """Sends a copy of the signal to the Davis Loop Station bridge, so that JACK applications (SooperLooper, Hydrogen...) can record or process it.

The audio passes through unchanged: this plugin never alters your sound. The copy is written to a shared buffer on the selected link (1 to 8), where the pedal_bridge JACK client picks it up. Use DLS Return with the same link to bring audio back from JACK.

Nothing is sent while no JACK client is listening; the Connected indicator lights up when one is.""" ;
    doap:license <http://opensource.org/licenses/isc> ;
    lv2:minorVersion 1 ;
    lv2:microVersion 0 ;
    lv2:optionalFeature lv2:hardRTCapable ;

    lv2:port [
        a lv2:AudioPort, lv2:InputPort ;
        lv2:index 0 ;
        lv2:symbol "in_l" ;
        lv2:name "In L"
    ] , [
        a lv2:AudioPort, lv2:InputPort ;
        lv2:index 1 ;
        lv2:symbol "in_r" ;
        lv2:name "In R"
    ] , [
        a lv2:AudioPort, lv2:OutputPort ;
        lv2:index 2 ;
        lv2:symbol "out_l" ;
        lv2:name "Out L"
    ] , [
        a lv2:AudioPort, lv2:OutputPort ;
        lv2:index 3 ;
        lv2:symbol "out_r" ;
        lv2:name "Out R"
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 4 ;
        lv2:symbol "link" ;
        lv2:name "Link" ;
        rdfs:comment "Bridge link (1 to 8) the copy is sent on. The pedal_bridge client exposes it as JACK ports sendN_L/R." ;
        lv2:default 1 ;
        lv2:minimum 1 ;
        lv2:maximum 8 ;
        lv2:portProperty lv2:integer, lv2:enumeration ;
        lv2:scalePoint [ rdfs:label "Link 1" ; rdf:value 1 ] ,
                       [ rdfs:label "Link 2" ; rdf:value 2 ] ,
                       [ rdfs:label "Link 3" ; rdf:value 3 ] ,
                       [ rdfs:label "Link 4" ; rdf:value 4 ] ,
                       [ rdfs:label "Link 5" ; rdf:value 5 ] ,
                       [ rdfs:label "Link 6" ; rdf:value 6 ] ,
                       [ rdfs:label "Link 7" ; rdf:value 7 ] ,
                       [ rdfs:label "Link 8" ; rdf:value 8 ]
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 5 ;
        lv2:symbol "gain" ;
        lv2:name "Send gain" ;
        rdfs:comment "Level of the copy sent to JACK. Does not change the signal passing through." ;
        lv2:default 0.0 ;
        lv2:minimum -60.0 ;
        lv2:maximum 12.0 ;
        units:unit units:db
    ] , [
        a lv2:ControlPort, lv2:OutputPort ;
        lv2:index 6 ;
        lv2:symbol "connected" ;
        lv2:name "Connected" ;
        rdfs:comment "Lit when the pedal_bridge JACK client is reading this link." ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:portProperty lv2:toggled
    ] .
