@prefix atom:  <http://lv2plug.in/ns/ext/atom#> .
@prefix doap:  <http://usefulinc.com/ns/doap#> .
@prefix epp:   <http://lv2plug.in/ns/ext/port-props#> .
@prefix lv2:   <http://lv2plug.in/ns/lv2core#> .
@prefix patch: <http://lv2plug.in/ns/ext/patch#> .
@prefix pipedal_ui: <http://github.com/rerdavies/pipedal/ui#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix state: <http://lv2plug.in/ns/ext/state#> .
@prefix urid:  <http://lv2plug.in/ns/ext/urid#> .
@prefix mod:   <http://moddevices.com/ns/mod#> .

<http://pedal-bridge.local/plugins/test#fichier>
    a lv2:Parameter ;
    rdfs:label "Fichier" ;
    mod:fileTypes "groove,h2song" ;
    rdfs:range atom:Path .

<http://pedal-bridge.local/plugins/test-mono>
    a lv2:Plugin, lv2:UtilityPlugin ;
    doap:name "Bridge Test (Mono)" ;
    rdfs:comment "Plugin de test du pont : contrôles, voyants et sélecteur de fichier dans PiPedal." ;
    doap:license <http://opensource.org/licenses/isc> ;
    lv2:minorVersion 1 ; lv2:microVersion 0 ;
    lv2:requiredFeature urid:map ;
    lv2:optionalFeature lv2:hardRTCapable ;
    lv2:extensionData state:interface ;
    patch:readable <http://pedal-bridge.local/plugins/test#fichier> ;
    patch:writable <http://pedal-bridge.local/plugins/test#fichier> ;
    lv2:port
    [ a lv2:AudioPort, lv2:InputPort ; lv2:index 0 ; lv2:symbol "in" ; lv2:name "Entrée" ] ,
    [ a lv2:AudioPort, lv2:OutputPort ; lv2:index 1 ; lv2:symbol "out" ; lv2:name "Sortie" ] ,
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 2 ; lv2:symbol "bascule" ; lv2:name "Bascule" ;
      lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:portProperty lv2:toggled ] ,
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 3 ; lv2:symbol "momentane" ; lv2:name "Momentané" ;
      lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:portProperty lv2:toggled, epp:trigger ] ,
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 4 ; lv2:symbol "liste" ; lv2:name "Liste" ;
      lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 3 ; lv2:portProperty lv2:integer, lv2:enumeration ;
      lv2:scalePoint [ rdfs:label "Choix A" ; rdf:value 0 ] , [ rdfs:label "Choix B" ; rdf:value 1 ] ,
                     [ rdfs:label "Choix C" ; rdf:value 2 ] , [ rdfs:label "Choix D" ; rdf:value 3 ] ] ,
    [ a lv2:ControlPort, lv2:OutputPort ; lv2:index 5 ; lv2:symbol "voyant" ; lv2:name "Voyant" ;
      lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:portProperty lv2:toggled ] ,
    [ a lv2:ControlPort, lv2:OutputPort ; lv2:index 6 ; lv2:symbol "compteur" ; lv2:name "Appuis" ;
      lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1000 ] ,
    [ a lv2:ControlPort, lv2:OutputPort ; lv2:index 7 ; lv2:symbol "clignote" ; lv2:name "Clignote" ;
      lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:portProperty lv2:toggled ] ,
    [ a lv2:ControlPort, lv2:OutputPort ; lv2:index 8 ; lv2:symbol "etat" ; lv2:name "État" ;
      lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 2 ; lv2:portProperty lv2:integer, lv2:enumeration ;
      lv2:scalePoint [ rdfs:label "vide" ; rdf:value 0 ] , [ rdfs:label "enregistre" ; rdf:value 1 ] ,
                     [ rdfs:label "lecture" ; rdf:value 2 ] ] ,
    [ a lv2:ControlPort, lv2:OutputPort ; lv2:index 9 ; lv2:symbol "longueur_nom" ; lv2:name "Nom reçu" ;
      lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1024 ] ,
    [ a lv2:ControlPort, lv2:OutputPort ; lv2:index 10 ; lv2:symbol "dossier_ok" ; lv2:name "Dossier créé" ;
      lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:portProperty lv2:toggled ] ,
    [ a atom:AtomPort, lv2:InputPort ; atom:bufferType atom:Sequence ; atom:supports patch:Message ;
      lv2:designation lv2:control ; lv2:index 11 ; lv2:symbol "control" ; lv2:name "Control" ] ,
    [ a atom:AtomPort, lv2:OutputPort ; atom:bufferType atom:Sequence ;
      lv2:designation lv2:control ; lv2:index 12 ; lv2:symbol "notify" ; lv2:name "Notify" ] .

<http://pedal-bridge.local/plugins/test-mono> pipedal_ui:ui <http://pedal-bridge.local/plugins/test-mono#ui> .

<http://pedal-bridge.local/plugins/test-mono#ui>
    a pipedal_ui:ui ;
    pipedal_ui:fileProperties [
        a pipedal_ui:fileProperty ;
        rdfs:label "Fichier" ;
        pipedal_ui:directory "PedalBridgeTest" ;
        lv2:index 5 ;
        pipedal_ui:patchProperty <http://pedal-bridge.local/plugins/test#fichier> ;
        pipedal_ui:fileTypes [
            a pipedal_ui:fileType ; rdfs:label "Groove" ;
            pipedal_ui:fileExtension ".groove" ; pipedal_ui:mimeType "application/octet-stream"
        ] , [
            a pipedal_ui:fileType ; rdfs:label "Morceau Hydrogen" ;
            pipedal_ui:fileExtension ".h2song" ; pipedal_ui:mimeType "application/octet-stream"
        ]
    ] .

<http://pedal-bridge.local/plugins/test-stereo>
    a lv2:Plugin, lv2:UtilityPlugin ;
    doap:name "Bridge Test (Stéréo)" ;
    rdfs:comment "Plugin de test du pont : contrôles, voyants et sélecteur de fichier dans PiPedal." ;
    doap:license <http://opensource.org/licenses/isc> ;
    lv2:minorVersion 1 ; lv2:microVersion 0 ;
    lv2:requiredFeature urid:map ;
    lv2:optionalFeature lv2:hardRTCapable ;
    lv2:extensionData state:interface ;
    patch:readable <http://pedal-bridge.local/plugins/test#fichier> ;
    patch:writable <http://pedal-bridge.local/plugins/test#fichier> ;
    lv2:port
    [ a lv2:AudioPort, lv2:InputPort ; lv2:index 0 ; lv2:symbol "in_l" ; lv2:name "Entrée G" ] ,
    [ a lv2:AudioPort, lv2:InputPort ; lv2:index 1 ; lv2:symbol "in_r" ; lv2:name "Entrée D" ] ,
    [ a lv2:AudioPort, lv2:OutputPort ; lv2:index 2 ; lv2:symbol "out_l" ; lv2:name "Sortie G" ] ,
    [ a lv2:AudioPort, lv2:OutputPort ; lv2:index 3 ; lv2:symbol "out_r" ; lv2:name "Sortie D" ] ,
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 4 ; lv2:symbol "bascule" ; lv2:name "Bascule" ;
      lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:portProperty lv2:toggled ] ,
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 5 ; lv2:symbol "momentane" ; lv2:name "Momentané" ;
      lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:portProperty lv2:toggled, epp:trigger ] ,
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 6 ; lv2:symbol "liste" ; lv2:name "Liste" ;
      lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 3 ; lv2:portProperty lv2:integer, lv2:enumeration ;
      lv2:scalePoint [ rdfs:label "Choix A" ; rdf:value 0 ] , [ rdfs:label "Choix B" ; rdf:value 1 ] ,
                     [ rdfs:label "Choix C" ; rdf:value 2 ] , [ rdfs:label "Choix D" ; rdf:value 3 ] ] ,
    [ a lv2:ControlPort, lv2:OutputPort ; lv2:index 7 ; lv2:symbol "voyant" ; lv2:name "Voyant" ;
      lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:portProperty lv2:toggled ] ,
    [ a lv2:ControlPort, lv2:OutputPort ; lv2:index 8 ; lv2:symbol "compteur" ; lv2:name "Appuis" ;
      lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1000 ] ,
    [ a lv2:ControlPort, lv2:OutputPort ; lv2:index 9 ; lv2:symbol "clignote" ; lv2:name "Clignote" ;
      lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:portProperty lv2:toggled ] ,
    [ a lv2:ControlPort, lv2:OutputPort ; lv2:index 10 ; lv2:symbol "etat" ; lv2:name "État" ;
      lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 2 ; lv2:portProperty lv2:integer, lv2:enumeration ;
      lv2:scalePoint [ rdfs:label "vide" ; rdf:value 0 ] , [ rdfs:label "enregistre" ; rdf:value 1 ] ,
                     [ rdfs:label "lecture" ; rdf:value 2 ] ] ,
    [ a lv2:ControlPort, lv2:OutputPort ; lv2:index 11 ; lv2:symbol "longueur_nom" ; lv2:name "Nom reçu" ;
      lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1024 ] ,
    [ a lv2:ControlPort, lv2:OutputPort ; lv2:index 12 ; lv2:symbol "dossier_ok" ; lv2:name "Dossier créé" ;
      lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:portProperty lv2:toggled ] ,
    [ a atom:AtomPort, lv2:InputPort ; atom:bufferType atom:Sequence ; atom:supports patch:Message ;
      lv2:designation lv2:control ; lv2:index 13 ; lv2:symbol "control" ; lv2:name "Control" ] ,
    [ a atom:AtomPort, lv2:OutputPort ; atom:bufferType atom:Sequence ;
      lv2:designation lv2:control ; lv2:index 14 ; lv2:symbol "notify" ; lv2:name "Notify" ] .

<http://pedal-bridge.local/plugins/test-stereo> pipedal_ui:ui <http://pedal-bridge.local/plugins/test-stereo#ui> .

<http://pedal-bridge.local/plugins/test-stereo#ui>
    a pipedal_ui:ui ;
    pipedal_ui:fileProperties [
        a pipedal_ui:fileProperty ;
        rdfs:label "Fichier" ;
        pipedal_ui:directory "PedalBridgeTest" ;
        lv2:index 7 ;
        pipedal_ui:patchProperty <http://pedal-bridge.local/plugins/test#fichier> ;
        pipedal_ui:fileTypes [
            a pipedal_ui:fileType ; rdfs:label "Groove" ;
            pipedal_ui:fileExtension ".groove" ; pipedal_ui:mimeType "application/octet-stream"
        ] , [
            a pipedal_ui:fileType ; rdfs:label "Morceau Hydrogen" ;
            pipedal_ui:fileExtension ".h2song" ; pipedal_ui:mimeType "application/octet-stream"
        ]
    ] .

