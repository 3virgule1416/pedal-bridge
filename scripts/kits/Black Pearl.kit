# Correspondance rôle -> instrument pour AVLDrumkits-BlackPearl-2023
# (Pearl DX 5 pièces, cymbales Sabian ; CC BY-SA, Glen MacArthur).
# Rôles : voir GMRockKit.kit. Un seul tom de rack : T1 et T2 = le même.
KIT    = AVLDrumkits-BlackPearl-2023
MODELE = ~/dls-modeles/AVLDrumkits-BlackPearl-2023.h2song
K  = Pearl-22-Kick
S  = Pearl-14-Snare
R  = Pearl-14-SnareEdge | Pearl-14-Snare
ST = Pearl-14-SideStick
SC = StickClick | Pearl-14-SideStick
H  = Sabian-13-HatClosed
P  = Sabian-13-HatPedal
O  = Sabian-13-HatSwish | Sabian-13-HatSemi
HS = Sabian-13-HatSemi
Y  = Sabian-20-Ride
B  = Sabian-20-RideBell
C  = Sabian-16-Crash | Sabian-17-Crash
Z  = Zildjian-10-Splash
C2 = Sabian-17-Crash | Paiste-22-Crash | Sabian-16-Crash
CH = Wuhan-18-ChinaCrash | Sabian-17-Crash
T1 = Pearl-12-Tom
T2 = Pearl-12-Tom
FT = Pearl-16-FloorTom
CB = Cowbell
CL = HandClap
