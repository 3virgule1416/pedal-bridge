# Correspondance rôle -> instrument pour AVLDrumkits-RedZeppelin-2023
# (Ludwig Centennial, cymbales Zildjian ; CC BY-SA, Glen MacArthur).
# Rôles : voir GMRockKit.kit. Un seul tom de rack : T1 et T2 = le même.
KIT    = AVLDrumkits-RedZeppelin-2023
MODELE = ~/dls-modeles/AVLDrumkits-RedZeppelin-2023.h2song
K  = Ludwig-26-Kick
S  = Ludwig-14-Snare
R  = Ludwig-14-SnareEdge | Ludwig-14-Snare
ST = Ludwig-14-SideStick
SC = StickClick | Ludwig-14-SideStick
H  = Sabian-13-HatClosed
P  = Sabian-13-HatPedal
O  = Sabian-13-HatSwish | Sabian-13-HatSemi
HS = Sabian-13-HatSemi
Y  = Zildjian-24-Ride
B  = Zildjian-24-RideBell
C  = Zildjian-20-Crash | Zildjian-17-Crash
Z  = Zildjian-10-Splash
T1 = Ludwig-14-Tom
T2 = Ludwig-14-Tom
FT = Ludwig-16-FloorTom
CB = Cowbell
CL = HandClap
